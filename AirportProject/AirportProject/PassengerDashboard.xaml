<Window x:Class="AirportProject.PassengerDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AirportProject"
        mc:Ignorable="d"
        Title="PassengerDashboard" Height="450" Width="800" Background="#FFD9D9D9">

    <Border Background="White" Margin="10" Padding="10" BorderBrush="Gray" BorderThickness="2" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="5" Opacity="0.3"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Welcome Passenger" Grid.Row="0"
                   FontSize="18" FontWeight="Bold" Foreground="#333"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <Border Grid.Row="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBox Text="Your Reservation:" Grid.Row="0" VerticalAlignment="Bottom" FontWeight="SemiBold" BorderThickness="0"/>

                    <DataGrid x:Name="dgMyFlights" Grid.Row="1" AutoGenerateColumns="True" 
                    IsReadOnly="True" SelectionMode="Single" BorderThickness="0"
                    AlternatingRowBackground="#FAFAFA" GridLinesVisibility="Horizontal"
                    SelectionChanged="dgMyFlights_SelectionChanged"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" BorderThickness="0,3,0,0" BorderBrush="Black" Padding="10" Background="#F9F9F9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="pnlTerms" Grid.Column="0" VerticalAlignment="Center" Visibility="Hidden">
                        <CheckBox x:Name="cbTerms" Content="I agree to the Terms of Service" 
                      FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBlock Text="* You must accept to confirm the booking." FontSize="10" Foreground="Red"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">

                        <Button x:Name="btnAction" Content="Select a Flight" 
                    Width="160" Height="40" Margin="5" 
                    FontSize="14" FontWeight="Bold"
                    IsEnabled="False" Background="Gray" Foreground="White"
                    Click="btnAction_Click"/>

                        <Button x:Name="btnExit" Content="Exit" 
                    Width="80" Height="40" Margin="5" 
                    Click="btnExit_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
