<Window x:Class="AirportProject.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AirportProject"
        mc:Ignorable="d"
        Title="Login" Height="350" Width="400" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    
    <Grid Background="#F0F0F0">
        <Border Background="White" CornerRadius="10" BorderThickness="10" Margin="10" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="WELCOME" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Username:" FontWeight="SemiBold"/>
                <TextBox x:Name="txtUsername" Height="30" Margin="0,5,0,15"/>

                <TextBlock Text="Password:" FontWeight="SemiBold"/>
                <PasswordBox x:Name="txtPassword" Height="30" Margin="0,5,0,15"/>

                <Button Content="Login" Height="30" Background="#2196F3" Foreground="White" FontWeight="Bold" Click="btnLogin_Click"/>
                <Button Content="Exit" Height="30" Margin="0,10,0,0" Background="Transparent" BorderThickness="0" Click="btnExit_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
