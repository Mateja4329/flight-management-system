<Window x:Class="AirportProject.Forms.AddReservationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AirportProject.Forms"
        mc:Ignorable="d"
        Title="New Reservation" Height="510" Width="400" WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Create New Reservation" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

            <TextBlock Text="Select Passenger:" FontWeight="SemiBold"/>
            <ComboBox x:Name="cbPassengers" Height="30" Margin="0,5,0,15" DisplayMemberPath="FullInfo" SelectedValuePath="passenger_ID"/>

            <TextBlock Text="Select Flight:" FontWeight="SemiBold"/>
            <ComboBox x:Name="cbFlights" Height="30" Margin="0,5,0,15" DisplayMemberPath="FlightInfo" SelectedValuePath="flight_ID"/>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                    <TextBlock Text="Total Price (€):" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtPrice" Height="30"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,5,0">
                    <TextBlock Text="Class" FontWeight="SemiBold"/>
                    <ComboBox x:Name="cbClass" Height="30" SelectedIndex="-1">
                        <ComboBoxItem Content="Economy"/>
                        <ComboBoxItem Content="Business"/>
                        <ComboBoxItem Content="First Class"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <TextBlock Text="Seat Number (e.g. 12A):" FontWeight="SemiBold"/>
            <TextBox x:Name="txtSeat" Height="30" Margin="0,2,0,15"/>

            <TextBlock Text="Check-In Type:" FontWeight="SemiBold"/>
            <ComboBox x:Name="cbCheckInType" Height="30" Margin="0,2,0,15" SelectedIndex="0">
                <ComboBoxItem Content="Live"/>
                <ComboBoxItem Content="Online"/>
            </ComboBox>

            <Button x:Name="btnSave" Content="CREATE RESERVATION (Pending)" Height="40" Background="#4CAF50" Foreground="White" FontWeight="Bold" Margin="0,10,0,0" Click="btnSave_Click"/>
            <Button x:Name="btnCancel" Content="Cancel" Height="30" Background="Transparent" Margin="0,5,0,0" Click="btnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
