<Window x:Class="AirportProject.Forms.PassengerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AirportProject.Forms"
        mc:Ignorable="d"
        Title="New Passenger" Height="450" Width="800" Background="#FF94D8FF" WindowStartupLocation="CenterScreen">

    <Border Background="white" Margin="10" Padding="10" BorderBrush="Gray" BorderThickness="2" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="5" Opacity="0.3"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="NEW PASSENGER REGISTRATION" Grid.Row="0"
                       FontSize="18" FontWeight="Bold" Foreground="#333"
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="First Name:" Grid.Row="0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox x:Name="f_name" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="300" Margin="10,0,0,0"/>

                    <TextBlock Text="Last Name:" Grid.Row="1" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox x:Name="l_name" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="300" Margin="10,0,0,0"/>

                    <TextBlock Text="Passport:" Grid.Row="2" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox x:Name="passportNo" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="300" Margin="10,0,0,0"/>

                    <TextBlock Text="UMCN:" Grid.Row="3" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox x:Name="UMCN" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="300" Margin="10,0,0,0"/>

                    <TextBlock Text="Email:" Grid.Row="4" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox x:Name="email" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="300" Margin="10,0,0,0"/>

                    <TextBlock Text="Address:" Grid.Row="5" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox x:Name="address" Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="300" Margin="10,0,0,0"/>

                    <TextBlock Text="Contact:" Grid.Row="6" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox x:Name="contact" Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="300" Margin="10,0,0,0"/>

                    <TextBlock Text="Username:" Grid.Row="7" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox x:Name="username" Grid.Row="7" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="300" Margin="10,0,0,0"/>

                    <TextBlock Text="Password:" Grid.Row="8" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <PasswordBox x:Name="password" Grid.Row="8" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="300" Margin="10,0,0,0"/>
                </Grid>
            </ScrollViewer>
            
            <Border Grid.Row="2" BorderThickness="0,3,0,0" BorderBrush="Black">
                <StackPanel  Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnCancel" Content="Cancel" Width="100" Height="30" Margin="5" Click="btnCancel_Click"/>
                    <Button x:Name="btnSubmit" Content="SUBMIT" Width="100" Height="30" Margin="5" FontWeight="Bold" Background="White" Click="btnSubmit_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
