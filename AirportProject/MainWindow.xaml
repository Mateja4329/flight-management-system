<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="AirportProject.MainWindow"
        Title="Airport Management System" Height="600" Width="1000" WindowStartupLocation="CenterScreen">

    <TabControl Margin="5">

        <TabItem Header="Passengers">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,10,0,10">
                    <Button x:Name="btnAddPassenger" Content="➕ New Passenger" 
                        Width="120" Height="30" Margin="5,0" Background="#E1F5FE"
                        Click="btnAddPassenger_Click"/>
                    <Button x:Name="btnEditPassenger" Content="🔄 Edit" 
                        Width="120" Height="30" Margin="5,0"
                        Click="btnEditPassenger_Click"/>
                    <Button x:Name="btnDeletePassenger" Content="❌ Delete" 
                        Width="120" Height="30" Margin="5,0" Background="#FFEBEE"
                        Click="btnDeletePassenger_Click"/>
                </StackPanel>

                <DataGrid x:Name="dgPassengers" Grid.Row="1" AutoGenerateColumns="True" 
                      IsReadOnly="True" SelectionMode="Single"
                      AlternatingRowBackground="#FAFAFA" GridLinesVisibility="Horizontal"/>

                <Border Grid.Row="2" BorderThickness="0,3,0,0" BorderBrush="Black">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnExit" Content="Exit" Width="100" Height="30" Margin="5" Click="btnExit_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </TabItem>

        <TabItem Header="Flights">
            <Grid>
                <DataGrid x:Name="dgFlights" AutoGenerateColumns="True" 
                      IsReadOnly="True" SelectionMode="Single"
                      AlternatingRowBackground="#FAFAFA" GridLinesVisibility="Horizontal"/>
            </Grid>
        </TabItem>

        <TabItem Header="Reservations">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,10,0,10">
                    <Button x:Name="btnAddReservation" Content="➕ New Reservation" 
                    Width="140" Height="30" Margin="5,0" Background="#E1F5FE"
                    Click="btnAddReservation_Click"/>

                    <Button x:Name="btnDeleteReservation" Content="❌ Delete" 
                     Width="120" Height="30" Margin="5,0" Background="#FFEBEE"
                    Click="btnDeleteReservation_Click"/>
                </StackPanel>
                
                

                <DataGrid x:Name="dgReservations" AutoGenerateColumns="True" 
                      IsReadOnly="True" SelectionMode="Single" Grid.Row="1"
                      AlternatingRowBackground="#FAFAFA" GridLinesVisibility="Horizontal"/>
            </Grid>
        </TabItem>
        
    </TabControl>
</Window>